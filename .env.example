# Copy to .env (backend reads real environment variables; use your shell or Docker to set them).
# REQUIRED in production: a long random secret, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
STORMSENSE_JWT_SECRET=change-me
STORMSENSE_JWT_EXPIRE_MINUTES=480

# Data locations (defaults shown are relative to the project root)
# STORMSENSE_RAW_DIR=data/raw
# STORMSENSE_PROCESSED_DIR=data/processed
# STORMSENSE_UPLOAD_DIR=data/uploads
# STORMSENSE_DB=data/stormsense.db

# Limits
STORMSENSE_MAX_UPLOAD_MB=100
STORMSENSE_MAX_PHOTO_MB=5
STORMSENSE_MAX_HIER_ROWS=15000

# External services. NWS asks for an identifying User-Agent with a contact address.
STORMSENSE_NWS_BASE=https://api.weather.gov
STORMSENSE_OSRM_BASE=https://router.project-osrm.org
STORMSENSE_USER_AGENT=StormSenseAI/1.0 (contact: you@example.com)
STORMSENSE_HTTP_TIMEOUT=10

# Browser origins allowed to call the API (comma separated)
STORMSENSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORMSENSE_LOG_LEVEL=INFO
